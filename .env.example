# Variables de entorno — copiar a .env y completar

# Requerido
OPENAI_API_KEY=sk-your-api-key-here

# Modelo LLM (default: gpt-4o-mini)
LLM_MODEL=gpt-4o-mini

# Modelo de embeddings (default: text-embedding-3-small)
EMBEDDING_MODEL=text-embedding-3-small

# Temperatura del LLM, entre 0 y 1 (default: 0.7)
LLM_TEMPERATURE=0.7

# Cantidad de documentos a recuperar por query (default: 3)
TOP_K=3

# Directorio del vector store (default: ./chroma_db)
CHROMA_DIR=./chroma_db

# Ruta al PDF a indexar
PDF_PATH=./data/AI_Engineer.pdf

# URL del sitio web a indexar
WEBSITE_URL=https://promtior.ai/
